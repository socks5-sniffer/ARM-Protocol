# ARM v0.8 local cross-model
# Keys are injected server-side by Vite's proxy — never bundled into browser code.
# Use plain (non-VITE-prefixed) names. Copy this file to .env and fill in your keys.

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE

# Legacy fallbacks (still supported if present, not required)
# GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
# VITE_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE

# ─── Production proxy (server.js / `npm start`) ──────────────────────────────────
# Shared secret that gates the keyed provider proxy at /api/*. REQUIRED in any
# publicly reachable deployment: without it server.js disables the proxy (HTTP 503)
# so the operator's API keys cannot be drained by anonymous traffic (denial-of-wallet).
# Generate one with, e.g.: openssl rand -hex 32
# Enter the same value in the app's "access token" field (stored client-side only).
ARM_ACCESS_TOKEN=YOUR_LONG_RANDOM_SHARED_SECRET_HERE

# Number of trusted reverse proxies in front of server.js (used to resolve the real
# client IP for rate limiting from X-Forwarded-For). OpenShift edge route = 1 (default).
# Set to 0 if the server is exposed directly with no proxy.
# TRUSTED_PROXY_COUNT=1

# ─── Provider model allowlists (server.js proxy) ─────────────────────────────────
# The keyed proxy validates each request's `model` against a per-provider allowlist
# so a caller holding the shared token cannot spend the operator's key on an
# arbitrarily expensive model (denial-of-wallet). Defaults track src/config.js;
# override with a comma-separated list only if you run non-default models.
# ARM_ALLOWED_ANTHROPIC_MODELS=claude-sonnet-4-6
# ARM_ALLOWED_OPENAI_MODELS=gpt-5.5-2026-04-23
# ARM_ALLOWED_OPENAI_EMBEDDING_MODELS=text-embedding-3-small
# (Gemini's allowlist lives in server.js as ALLOWED_GEMINI_MODELS.)

# ─── Dev server (vite.config.js — `npm run dev` only) ────────────────────────────
# The Vite dev proxy injects your provider keys into /api/* requests. On a shared or
# exposed dev host (e.g. OpenShift Dev Spaces), set ARM_DEV_PROXY_TOKEN so the dev
# proxy requires it as `x-arm-token` before spending a key — mirrors the production
# gate. Leave unset for a purely local loopback dev session.
# ARM_DEV_PROXY_TOKEN=YOUR_LONG_RANDOM_DEV_SECRET_HERE
#
# Dev server host allowlist. Vite's default (loopback + one configured host) is now
# the default here; `allowedHosts: "all"` is no longer hardcoded because it disables
# the host check that prevents DNS-rebinding against the key-injecting proxy. Dev
# Spaces' dynamic hostnames need this set — a comma-separated list, or the literal
# "all" to opt back into wide-open (pair "all" with ARM_DEV_PROXY_TOKEN).
# VITE_ALLOWED_HOSTS=all

# Optional dev-only convenience: bakes the token into the built bundle (visible to
# anyone with the bundle). Do NOT use for public builds — prefer the in-app field.
# VITE_ARM_ACCESS_TOKEN=YOUR_LONG_RANDOM_SHARED_SECRET_HERE
