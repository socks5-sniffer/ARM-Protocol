# ARM v0.7.1 local cross-model
# Keys are injected server-side by Vite's proxy — never bundled into browser code.
# Use plain (non-VITE-prefixed) names. Copy this file to .env and fill in your keys.

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
GOOGLE_API_KEY=YOUR_GOOGLE_AI_STUDIO_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE

# Legacy fallbacks (still supported if present, not required)
# GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE
# VITE_ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
