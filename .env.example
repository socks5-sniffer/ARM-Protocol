# Server-side keys (NO VITE_ prefix) — injected by the Vite proxy, never bundled into client JS.
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY_HERE
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_KEY_HERE

# Client-visible config — safe to expose (no secrets).
VITE_ANTHROPIC_MODEL=claude-sonnet-4-6
VITE_TOKENS_R1=5000
VITE_TOKENS_R2=6500
VITE_TOKENS_GAMMA=8000
